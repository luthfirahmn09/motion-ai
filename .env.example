# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
WEBHOOK_URL=

# Freepik Magnific API (Kling v2.6 Motion Control)
FREEPIK_API_KEY=your_freepik_api_key_here

# Kling config
KLING_ORIENTATION=video
KLING_DURATION=10

# Redis
REDIS_URL=redis://localhost:6379/0

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/motionbot

# Storage lokal
STORAGE_BACKEND=local
TEMP_DIR=./storage

# Rate limiting
MAX_CONCURRENT_JOBS_PER_USER=1
MAX_JOBS_PER_USER_PER_DAY=10
GLOBAL_API_CALLS_PER_MINUTE=15

# Worker
CELERY_CONCURRENCY=4
POLLING_INTERVAL_SEC=5
POLLING_MAX_RETRIES=72

# File limits (Freepik: maks 10MB image & video, 3-30 detik)
MAX_PHOTO_SIZE_MB=10
MAX_VIDEO_SIZE_MB=10
MIN_VIDEO_DURATION_SEC=3
MAX_VIDEO_DURATION_SEC=30

# Stealth / Proxy (anti-abuse bypass)
# Option 1: Single rotating proxy (residential proxy service)
PROXY_URL=
# Option 2: Static proxy list (comma-separated, supports host:port:user:pass format)
PROXY_LIST=host1:port:user:pass,host2:port:user:pass
# Enable/disable stealth mode (auto-enabled if proxy configured)
STEALTH_ENABLED=true
# Random delay range (seconds) before each API create request
REQUEST_DELAY_MIN=1.0
REQUEST_DELAY_MAX=3.0

# Midtrans
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxx
MIDTRANS_IS_PRODUCTION=false
